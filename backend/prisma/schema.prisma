}

model BookingAccessToken {
  /// ID token
  id String @id(map: "booking_access_tokens_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// Đơn được truy cập
  bookingId String @map("booking_id") @db.Uuid
