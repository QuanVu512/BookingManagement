  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  /// Kết quả cuối cùng đã xác minh
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  /// Tham chiếu chứng từ chi riêng tư
  evidenceReference String? @map("evidence_reference") @db.Text
  /// Mã lỗi
  failureCode String? @map("failure_code") @db.VarChar(100)
  /// Lỗi đã lọc secret
  failureMessage String? @map("failure_message") @db.Text
  /// Tạo
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Cập nhật
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  refundRequest RefundRequest @relation("RefundAttempt_refundRequest", fields: [refundRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refund_attempts_refund_request_id_fkey")
  executedByUser User? @relation("RefundAttempt_executedByUser", fields: [executedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refund_attempts_executed_by_user_id_fkey")
  @@unique([refundRequestId, attemptNumber], map: "refund_attempts_refund_request_id_attempt_number_key")
  // Nullable composite dedup is a SQL-only partial unique index: refund_attempts_provider_provider_payout_id_key
  @@index([status, updatedAt], map: "refund_attempts_status_updated_at_idx")
  @@map("refund_attempts")
}

model NotificationDelivery {
  /// ID lần gửi logic
  id String @id(map: "notification_deliveries_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// Đơn liên quan
  bookingId String @map("booking_id") @db.Uuid
  /// Email snapshot nhận thông báo
  recipientEmail String @map("recipient_email") @db.VarChar(254)
  /// BOOKING_CONFIRMED, CHECKIN_CODE, BOOKING_CANCELLED, REFUND_UPDATED
  templateCode NotificationTemplate @map("template_code")
  /// Nội dung/token gửi email nếu cần lưu để retry, mã hóa và có thời hạn lưu
  payloadEncrypted Bytes? @map("payload_encrypted") @db.ByteA
  /// Chống tạo nhiều job cùng sự kiện/phiên bản token
  deduplicationKey String @unique(map: "notification_deliveries_deduplication_key_key") @map("deduplication_key") @db.VarChar(150)
  /// QUEUED, SENDING, SENT, FAILED
  status NotificationStatus @default(QUEUED) @map("status")
  /// Số lần thử
  attemptCount Int @default(0) @map("attempt_count")
  /// Lịch retry
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(6)
  /// ID nhà cung cấp email
  providerMessageId String? @map("provider_message_id") @db.VarChar(150)
  /// Lỗi đã lọc secret/token
  lastError String? @map("last_error") @db.Text
  /// Provider đã chấp nhận gửi
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
  /// Tạo
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Cập nhật
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation("NotificationDelivery_booking", fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "notification_deliveries_booking_id_fkey")
  @@index([status, nextRetryAt], map: "notification_deliveries_status_next_retry_at_idx")
  @@index([bookingId], map: "notification_deliveries_booking_id_idx")
  @@map("notification_deliveries")
}

model OutboxEvent {
  /// event_id toàn cục
  id String @id(map: "outbox_events_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// BOOKING, PAYMENT, REFUND…
  aggregateType String @map("aggregate_type") @db.VarChar(50)
  /// Đối tượng sở hữu event
  aggregateId String @map("aggregate_id") @db.Uuid
  /// booking.confirmed, booking.cancelled, payment.received…
  eventType String @map("event_type") @db.VarChar(100)
  /// Phiên bản contract
  eventVersion Int @default(1) @map("event_version") @db.SmallInt
  /// Dữ liệu tối thiểu, không chứa secret/raw token
  payload Json @map("payload") @db.JsonB
  /// Thời điểm nghiệp vụ
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Broker đã xác nhận nhận
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  /// Số lần publish
  attemptCount Int @default(0) @map("attempt_count")
  /// Retry
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(6)
  /// Lỗi publish đã lọc
  lastError String? @map("last_error") @db.Text

  @@index([publishedAt, nextRetryAt], map: "outbox_events_published_at_next_retry_at_idx")
  @@map("outbox_events")
}
