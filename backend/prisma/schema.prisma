  tokenHash String @unique(map: "booking_access_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  /// Hết hạn theo mục đích token
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  /// Token CHECKIN đã dùng
