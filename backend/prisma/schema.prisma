  booking Booking @relation("BookingAccessToken_booking", fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "booking_access_tokens_booking_id_fkey")
  checkins BookingCheckin[] @relation("BookingCheckin_token")
  @@unique([id, bookingId], map: "booking_access_tokens_id_booking_id_key")
  @@index([bookingId, purpose], map: "booking_access_tokens_booking_id_purpose_idx")
  @@map("booking_access_tokens")
}

