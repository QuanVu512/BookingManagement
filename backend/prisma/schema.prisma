  amount Decimal @map("amount") @db.Decimal(14,0)
  /// Đồng tiền
  currency String @default("VND") @map("currency") @db.Char(3)
  /// PAYOS_TRANSFER, MANUAL_BANK_TRANSFER, CASH
  method PaymentMethod @map("method")
  /// PAYOS cho yêu cầu qua API; NULL cho thu trực tiếp
  provider String? @map("provider") @db.VarChar(30)
  /// ID kênh thu dùng lúc tạo
  providerChannelId String? @map("provider_channel_id") @db.VarChar(100)
  /// orderCode số nguyên của payOS
  providerOrderCode BigInt? @map("provider_order_code") @db.BigInt
  /// ID link do provider trả về
  providerPaymentLinkId String? @map("provider_payment_link_id") @db.VarChar(100)
  /// URL thanh toán nếu có
  checkoutUrl String? @map("checkout_url") @db.Text
  /// CREATING, PENDING, PARTIALLY_PAID, PAID, CANCELLED, EXPIRED, FAILED
  status PaymentRequestStatus @default(CREATING) @map("status")
  /// Deadline link/hold; thu tại quầy có thể không cần
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  /// Tránh tạo yêu cầu thu trùng
  idempotencyKey String @unique(map: "payment_requests_idempotency_key_key") @map("idempotency_key") @db.VarChar(100)
  /// Nhân viên tạo yêu cầu tại quầy
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  /// Tạo
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Cập nhật
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation("PaymentRequest_booking", fields: [referenceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_requests_reference_id_fkey")
  createdByUser User? @relation("PaymentRequest_createdByUser", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_requests_created_by_user_id_fkey")
  transactions PaymentTransaction[] @relation("PaymentTransaction_paymentRequest")
  // Nullable composite dedup is a SQL-only partial unique index: payment_requests_provider_provider_channel_id_provider_orde_key
  // Nullable composite dedup is a SQL-only partial unique index: payment_requests_provider_provider_channel_id_provider_paym_key
  @@index([referenceType, referenceId], map: "payment_requests_reference_type_reference_id_idx")
  @@map("payment_requests")
}

model PaymentTransaction {
  /// ID receipt
  id String @id(map: "payment_transactions_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// NULL nếu nhận khoản chưa khớp đơn
  paymentRequestId String? @map("payment_request_id") @db.Uuid
  /// PAYOS nếu từ provider
  provider String? @map("provider") @db.VarChar(30)
  /// BANK_TRANSFER, CASH
  method ReceiptMethod @map("method")
  /// Định danh tài khoản ngân hàng/quỹ tiền mặt nội bộ
  receivingAccountKey String @map("receiving_account_key") @db.VarChar(100)
  /// Mã giao dịch ngân hàng; NULL cho cash
  transactionReference String? @map("transaction_reference") @db.VarChar(150)
  /// Số tiền thực nhận
  amount Decimal @map("amount") @db.Decimal(14,0)
  /// Đồng tiền
  currency String @default("VND") @map("currency") @db.Char(3)
  /// UNVERIFIED, VERIFIED, REJECTED
  verificationStatus ReceiptVerificationStatus @default(UNVERIFIED) @map("verification_status")
  /// UNALLOCATED, ALLOCATED, REFUND_REQUIRED
  allocationStatus ReceiptAllocationStatus @default(UNALLOCATED) @map("allocation_status")
  /// WEBHOOK, PROVIDER_QUERY, STAFF
  confirmationSource ConfirmationSource @map("confirmation_source")
  /// Thời điểm tiền thực nhận theo nguồn đã kiểm tra
  fundsReceivedAt DateTime? @map("funds_received_at") @db.Timestamptz(6)
  /// Người nhập thông tin tại quầy
  recordedByUserId String? @map("recorded_by_user_id") @db.Uuid
  /// Nhân viên xác nhận; NULL khi provider tự xác minh
  verifiedByUserId String? @map("verified_by_user_id") @db.Uuid
  /// Thời điểm xác minh
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  /// Ghi chú đối soát/thủ công
  verificationNote String? @map("verification_note") @db.Text
  /// Tham chiếu chứng từ riêng tư, không phải ảnh công khai
  evidenceReference String? @map("evidence_reference") @db.Text
  /// Khoản sai tiền, muộn, chưa khớp…
  reviewReason String? @map("review_reason") @db.Text
  /// Tránh nhân viên/webhook ghi lại receipt
  idempotencyKey String @unique(map: "payment_transactions_idempotency_key_key") @map("idempotency_key") @db.VarChar(100)
  /// Server nhận/ghi receipt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Cập nhật xác minh/phân bổ
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentRequest PaymentRequest? @relation("PaymentTransaction_paymentRequest", fields: [paymentRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_transactions_payment_request_id_fkey")
  recordedByUser User? @relation("PaymentTransaction_recordedByUser", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_transactions_recorded_by_user_id_fkey")
  verifiedByUser User? @relation("PaymentTransaction_verifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_transactions_verified_by_user_id_fkey")
  refundRequests RefundRequest[] @relation("RefundRequest_paymentTransaction")
  // Nullable composite dedup is a SQL-only partial unique index: payment_transactions_receiving_account_key_transaction_refe_key
  @@index([paymentRequestId], map: "payment_transactions_payment_request_id_idx")
  @@index([verificationStatus, createdAt], map: "payment_transactions_verification_status_created_at_idx")
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  /// ID lần nhận
  id String @id(map: "payment_webhook_events_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
