model PaymentRequest {
  /// ID yêu cầu thu
  id String @id(map: "payment_requests_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// Mã thu nội bộ
  paymentCode String @unique(map: "payment_requests_payment_code_key") @map("payment_code") @db.VarChar(32)
