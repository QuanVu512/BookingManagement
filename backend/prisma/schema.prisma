// Modular monolith: one PostgreSQL database, public schema.
// SQL-only CHECK, partial/expression indexes and exclusion constraint are in migration v1.
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  @@map("user_status")
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
  @@map("role")
}

enum CourtType {
  STANDARD
  VIP
  @@map("court_type")
}

enum CourtStatus {
  ACTIVE
  INACTIVE
  @@map("court_status")
}

enum BookingSource {
  CUSTOMER_WEB
  STAFF_COUNTER
  @@map("booking_source")
}

enum BookingStatus {
  HOLDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  EXPIRED
  CANCELLED
  NO_SHOW
  @@map("booking_status")
}

enum CancellationRule {
  BEFORE_START
  BEFORE_CHECKIN
  @@map("cancellation_rule")
}

enum OccupancyKind {
  BOOKING
  BLOCK
  @@map("occupancy_kind")
}

enum OccupancyState {
  ACTIVE
  RELEASED
  @@map("occupancy_state")
}

enum ActorType {
  SYSTEM
  CUSTOMER
  GUEST
  STAFF
  @@map("actor_type")
}

enum BookingTokenPurpose {
  CHECKIN
  MANAGE_BOOKING
  @@map("booking_token_purpose")
}

enum CheckinMethod {
  QR
  MANUAL
  @@map("checkin_method")
}

enum CancellationRequestStatus {
  QUOTED
  ACCEPTED
  APPLIED
  EXPIRED
  SUPERSEDED
  REJECTED
  @@map("cancellation_request_status")
}

enum PaymentReferenceType {
  BOOKING
  @@map("payment_reference_type")
}

enum PaymentPurpose {
  PREPAYMENT
  BALANCE
  @@map("payment_purpose")
}

enum PaymentMethod {
  PAYOS_TRANSFER
  MANUAL_BANK_TRANSFER
  CASH
  @@map("payment_method")
}

enum ReceiptMethod {
  BANK_TRANSFER
  CASH
  @@map("receipt_method")
}

enum ReceiptVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  @@map("receipt_verification_status")
}

enum ReceiptAllocationStatus {
  UNALLOCATED
  ALLOCATED
  REFUND_REQUIRED
  @@map("receipt_allocation_status")
}

enum ConfirmationSource {
  WEBHOOK
  PROVIDER_QUERY
  STAFF
  @@map("confirmation_source")
}

enum WebhookKind {
  PAYMENT
  PAYOUT
  @@map("webhook_kind")
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  @@map("webhook_status")
}

enum RefundReasonType {
  CUSTOMER_CANCELLATION
  LATE_PAYMENT
  OVERPAYMENT
  MERCHANT_CANCELLATION
  @@map("refund_reason_type")
}

enum RefundMethod {
  PAYOS_PAYOUT
  MANUAL_BANK_TRANSFER
  CASH
  @@map("refund_method")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
  @@map("refund_status")
}

enum ApprovalSource {
  MANAGER
  SYSTEM_POLICY
  @@map("approval_source")
}

enum RefundAttemptStatus {
  CREATED
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
  @@map("refund_attempt_status")
}

enum NotificationTemplate {
  BOOKING_CONFIRMED
  CHECKIN_CODE
  BOOKING_CANCELLED
  REFUND_UPDATED
  @@map("notification_template")
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  @@map("notification_status")
}

enum PaymentRequestStatus {
  CREATING
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED
  FAILED
  @@map("payment_request_status")
}

model User {
  id String @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  username String @unique(map: "users_username_key") @map("username") @db.VarChar(100)
  phone String @unique(map: "users_phone_key") @map("phone") @db.VarChar(20)
  email String @unique(map: "users_email_key") @map("email") @db.VarChar(254)
  passwordHash String @map("password_hash") @db.VarChar(255)
  status UserStatus @default(ACTIVE) @map("status")
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  tokenVersion Int @default(0) @map("token_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile UserProfile? @relation("UserProfile_user")
  roles UserRole[] @relation("UserRole_user")
  assignedRoles UserRole[] @relation("UserRole_assignedByUser")
  refreshTokens RefreshToken[] @relation("RefreshToken_user")
  bookings Booking[] @relation("Booking_customer")
  cancelledBookings Booking[] @relation("Booking_cancelledByUser")
  createdBookings Booking[] @relation("Booking_createdByUser")
  createdOccupancies CourtOccupancy[] @relation("CourtOccupancy_createdByUser")
  bookingStatusChanges BookingStatusHistory[] @relation("BookingStatusHistory_actorUser")
  checkins BookingCheckin[] @relation("BookingCheckin_staffUser")
  cancellationRequests BookingCancellationRequest[] @relation("BookingCancellationRequest_requestedByUser")
  paymentRequests PaymentRequest[] @relation("PaymentRequest_createdByUser")
  recordedTransactions PaymentTransaction[] @relation("PaymentTransaction_recordedByUser")
  verifiedTransactions PaymentTransaction[] @relation("PaymentTransaction_verifiedByUser")
  requestedRefunds RefundRequest[] @relation("RefundRequest_requestedByUser")
  approvedRefunds RefundRequest[] @relation("RefundRequest_approvedByUser")
  refundAttempts RefundAttempt[] @relation("RefundAttempt_executedByUser")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserProfile {
  userId String @id(map: "user_profiles_pkey") @map("user_id") @db.Uuid
  fullName String @map("full_name") @db.VarChar(150)
  avatarUrl String? @map("avatar_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("UserProfile_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "user_profiles_user_id_fkey")
  @@map("user_profiles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  role Role @map("role")
  assignedByUserId String? @map("assigned_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("UserRole_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "user_roles_user_id_fkey")
  assignedByUser User? @relation("UserRole_assignedByUser", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "user_roles_assigned_by_user_id_fkey")
  @@id([userId, role], map: "user_roles_pkey")
  @@index([assignedByUserId], map: "user_roles_assigned_by_user_id_idx")
  @@map("user_roles")
}

model RefreshToken {
  id String @id(map: "refresh_tokens_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  tokenFamilyId String @map("token_family_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason String? @map("revoke_reason") @db.VarChar(100)
  replacedByTokenId String? @map("replaced_by_token_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("RefreshToken_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refresh_tokens_user_id_fkey")
  replacedByToken RefreshToken? @relation("RefreshToken_replacedByToken", fields: [replacedByTokenId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refresh_tokens_replaced_by_token_id_fkey")
  rotationPredecessors RefreshToken[] @relation("RefreshToken_replacedByToken")
  @@index([tokenFamilyId], map: "refresh_tokens_token_family_id_idx")
  @@index([userId, expiresAt], map: "refresh_tokens_user_id_expires_at_idx")
  @@index([replacedByTokenId], map: "refresh_tokens_replaced_by_token_id_idx")
  @@map("refresh_tokens")
}

model Branch {
  id String @id(map: "branches_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  code String @unique(map: "branches_code_key") @map("code") @db.VarChar(30)
  name String @map("name") @db.VarChar(150)
  address String @map("address") @db.VarChar(500)
  phone String @map("phone") @db.VarChar(20)
  timezone String @default("Asia/Ho_Chi_Minh") @map("timezone") @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  courts Court[] @relation("Court_branch")
  businessHours BranchBusinessHour[] @relation("BranchBusinessHour_branch")
  bookings Booking[] @relation("Booking_branch")
  @@map("branches")
}

model Court {
  id String @id(map: "courts_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  code String @map("code") @db.VarChar(30)
  name String @map("name") @db.VarChar(100)
  courtType CourtType @default(STANDARD) @map("court_type")
  status CourtStatus @default(ACTIVE) @map("status")
  cleanupMinutes Int @default(15) @map("cleanup_minutes") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation("Court_branch", fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "courts_branch_id_fkey")
  priceRules PriceRule[] @relation("PriceRule_court")
  bookings Booking[] @relation("Booking_court")
  occupancies CourtOccupancy[] @relation("CourtOccupancy_court")
  @@unique([branchId, code], map: "courts_branch_id_code_key")
  @@unique([id, branchId], map: "courts_id_branch_id_key")
  @@index([branchId], map: "courts_branch_id_idx")
  @@map("courts")
}

model BranchBusinessHour {
  id String @id(map: "branch_business_hours_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  dayOfWeek Int @map("day_of_week") @db.SmallInt
  openTime DateTime? @map("open_time") @db.Time(6)
  closeTime DateTime? @map("close_time") @db.Time(6)
  isClosed Boolean @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation("BranchBusinessHour_branch", fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "branch_business_hours_branch_id_fkey")
  @@unique([branchId, dayOfWeek], map: "branch_business_hours_branch_id_day_of_week_key")
  @@map("branch_business_hours")
}

model PriceRule {
  /// ID rule
  id String @id(map: "price_rules_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// Sân áp dụng
  courtId String @map("court_id") @db.Uuid
  /// NULL = mọi thứ; cuối tuần tạo rule cho 6 và 7
  dayOfWeek Int? @map("day_of_week") @db.SmallInt
  /// Bắt đầu khung giá
  startTime DateTime @map("start_time") @db.Time(6)
  /// Kết thúc khung giá
  endTime DateTime @map("end_time") @db.Time(6)
  /// Giá/giờ VND
  pricePerHour Decimal @map("price_per_hour") @db.Decimal(14,0)
  /// Ngày bắt đầu hiệu lực
  effectiveFrom DateTime @map("effective_from") @db.Date
  /// Ngày kết thúc, có bao gồm ngày này
  effectiveTo DateTime? @map("effective_to") @db.Date
  /// Rule cao hơn thắng khi nhiều rule khớp
  priority Int @default(0) @map("priority")
  /// Bật/tắt rule
  isActive Boolean @default(true) @map("is_active")
  /// Tạo
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Cập nhật
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  court Court @relation("PriceRule_court", fields: [courtId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "price_rules_court_id_fkey")
  bookingPriceItems BookingPriceItem[] @relation("BookingPriceItem_priceRule")
  @@index([courtId, isActive, effectiveFrom], map: "price_rules_court_id_is_active_effective_from_idx")
  @@map("price_rules")
}

model Booking {
  /// ID booking
  id String @id(map: "bookings_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// Mã đơn hiển thị, không phải token truy cập
  bookingCode String @unique(map: "bookings_booking_code_key") @map("booking_code") @db.VarChar(32)
  /// NULL = khách vãng lai
  userId String? @map("user_id") @db.Uuid
  /// Chi nhánh; hiện một giá trị
  branchId String @map("branch_id") @db.Uuid
  /// Sân đã chọn
  courtId String @map("court_id") @db.Uuid
  /// CUSTOMER_WEB, STAFF_COUNTER
  source BookingSource @map("source")
  /// Snapshot tên người đặt
  customerName String @map("customer_name") @db.VarChar(150)
  /// Snapshot email gửi thông báo/check-in
  customerEmail String @map("customer_email") @db.VarChar(254)
  /// Snapshot điện thoại liên hệ
  customerPhone String @map("customer_phone") @db.VarChar(20)
  /// Bắt đầu chơi
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  /// Kết thúc chơi
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  /// Snapshot khoảng vệ sinh tại lúc đặt
  cleanupMinutes Int @default(15) @map("cleanup_minutes") @db.SmallInt
  /// Tổng giá sân đã chốt
  totalAmount Decimal @map("total_amount") @db.Decimal(14,0)
  /// 30.00 hoặc 100.00
  prepaymentPercent Decimal @map("prepayment_percent") @db.Decimal(5,2)
  /// Khoản cần nhận để xác nhận booking
  requiredPrepaymentAmount Decimal @map("required_prepayment_amount") @db.Decimal(14,0)
  /// Đồng tiền
  currency String @default("VND") @map("currency") @db.Char(3)
  /// HOLDING, CONFIRMED, CHECKED_IN, COMPLETED, EXPIRED, CANCELLED, NO_SHOW
  status BookingStatus @default(HOLDING) @map("status")
  /// Deadline thanh toán khoản trả trước, giữ để audit kể cả đã xác nhận
  holdExpiresAt DateTime @map("hold_expires_at") @db.Timestamptz(6)
  /// Thời điểm xác nhận booking
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// BEFORE_START hoặc BEFORE_CHECKIN; giá trị còn cần chốt
  cancellationRule CancellationRule @map("cancellation_rule")
  /// starts_at cho BEFORE_START; NULL nếu chỉ giới hạn bởi check-in
  cancellationDeadlineAt DateTime? @map("cancellation_deadline_at") @db.Timestamptz(6)
  /// Snapshot phí hủy/tổng giá sân
  cancellationPenaltyPercent Decimal @default(10) @map("cancellation_penalty_percent") @db.Decimal(5,2)
  /// Phiên bản điều khoản đã chốt
  policyVersion String @map("policy_version") @db.VarChar(30)
  /// Khách đồng ý điều khoản khi đặt
  policyAcceptedAt DateTime @map("policy_accepted_at") @db.Timestamptz(6)
  /// Thời điểm hủy thực tế
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// NULL cho guest/hệ thống; đối chiếu actor_type trong lịch sử
  cancelledByUserId String? @map("cancelled_by_user_id") @db.Uuid
  /// Lý do hủy
  cancellationReason String? @map("cancellation_reason") @db.Text
  /// Nhân viên tạo tại quầy, nếu có
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  /// Tránh tạo hai đơn do gửi lại request
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  /// Kiểm soát sửa trạng thái đồng thời
  version Int @default(0) @map("version")
  /// Tạo
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Cập nhật
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer User? @relation("Booking_customer", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_user_id_fkey")
  branch Branch @relation("Booking_branch", fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_branch_id_fkey")
  court Court @relation("Booking_court", fields: [courtId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict, map: "bookings_court_id_branch_id_fkey")
  cancelledByUser User? @relation("Booking_cancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_cancelled_by_user_id_fkey")
  createdByUser User? @relation("Booking_createdByUser", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_created_by_user_id_fkey")
  occupancies CourtOccupancy[] @relation("CourtOccupancy_booking")
  priceItems BookingPriceItem[] @relation("BookingPriceItem_booking")
  statusHistory BookingStatusHistory[] @relation("BookingStatusHistory_booking")
  accessTokens BookingAccessToken[] @relation("BookingAccessToken_booking")
  checkin BookingCheckin? @relation("BookingCheckin_booking")
  cancellationRequests BookingCancellationRequest[] @relation("BookingCancellationRequest_booking")
  paymentRequests PaymentRequest[] @relation("PaymentRequest_booking")
  notificationDeliveries NotificationDelivery[] @relation("NotificationDelivery_booking")
  @@unique([id, courtId], map: "bookings_id_court_id_key")
  @@unique([userId, idempotencyKey], map: "bookings_user_id_idempotency_key_key")
  @@index([courtId, startsAt], map: "bookings_court_id_starts_at_idx")
  @@index([userId, createdAt], map: "bookings_user_id_created_at_idx")
  @@index([status, holdExpiresAt], map: "bookings_status_hold_expires_at_idx")
  @@index([customerPhone], map: "bookings_customer_phone_idx")
  @@map("bookings")
}

model CourtOccupancy {
  /// ID khoảng chiếm sân
  id String @id(map: "court_occupancies_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// Sân
  courtId String @map("court_id") @db.Uuid
  /// Booking sở hữu khoảng; NULL cho block
  bookingId String? @unique(map: "court_occupancies_booking_id_key") @map("booking_id") @db.Uuid
  /// BOOKING, BLOCK
  kind OccupancyKind @map("kind")
  /// Bắt đầu khoảng chiếm lịch
  occupiedFrom DateTime @map("occupied_from") @db.Timestamptz(6)
  /// Kết thúc khoảng chiếm lịch, đã cộng vệ sinh
  occupiedUntil DateTime @map("occupied_until") @db.Timestamptz(6)
  /// ACTIVE, RELEASED
  state OccupancyState @default(ACTIVE) @map("state")
  /// Bắt buộc cho BLOCK, ví dụ bảo trì/ngày lễ
  reason String? @map("reason") @db.Text
  /// Người chặn lịch
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  /// Giải phóng do hủy/hết hạn
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  /// Tạo
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Cập nhật
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  court Court @relation("CourtOccupancy_court", fields: [courtId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "court_occupancies_court_id_fkey")
  booking Booking? @relation("CourtOccupancy_booking", fields: [bookingId, courtId], references: [id, courtId], onDelete: Restrict, onUpdate: Restrict, map: "court_occupancies_booking_id_court_id_fkey")
  createdByUser User? @relation("CourtOccupancy_createdByUser", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "court_occupancies_created_by_user_id_fkey")
  @@index([courtId, occupiedFrom], map: "court_occupancies_court_id_occupied_from_idx")
  @@index([state, occupiedUntil], map: "court_occupancies_state_occupied_until_idx")
  @@map("court_occupancies")
}

model BookingPriceItem {
  /// ID dòng giá
  id String @id(map: "booking_price_items_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// Đơn sở hữu
  bookingId String @map("booking_id") @db.Uuid
  /// Rule gốc nếu còn tồn tại
  priceRuleId String? @map("price_rule_id") @db.Uuid
  /// Bắt đầu đoạn tính giá
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  /// Kết thúc đoạn tính giá
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  /// Thời lượng đoạn
  durationMinutes Int @map("duration_minutes")
  /// Giá/giờ đã chốt
  pricePerHour Decimal @map("price_per_hour") @db.Decimal(14,0)
  /// Tiền đoạn sau làm tròn
  amount Decimal @map("amount") @db.Decimal(14,0)
  /// Mô tả khung giá
  description String? @map("description") @db.VarChar(255)
  /// Tạo snapshot
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation("BookingPriceItem_booking", fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "booking_price_items_booking_id_fkey")
  priceRule PriceRule? @relation("BookingPriceItem_priceRule", fields: [priceRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "booking_price_items_price_rule_id_fkey")
  @@index([bookingId], map: "booking_price_items_booking_id_idx")
  @@map("booking_price_items")
}

model BookingStatusHistory {
  /// ID lịch sử
  id String @id(map: "booking_status_history_pkey") @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  /// Đơn
  bookingId String @map("booking_id") @db.Uuid
  /// NULL cho trạng thái đầu tiên
  fromStatus BookingStatus? @map("from_status")
  /// Trạng thái mới
  toStatus BookingStatus @map("to_status")
  /// SYSTEM, CUSTOMER, GUEST, STAFF
  actorType ActorType @map("actor_type")
  /// Người thao tác nếu có tài khoản
  actorUserId String? @map("actor_user_id") @db.Uuid
  /// Lý do nghiệp vụ
