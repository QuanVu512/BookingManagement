  requestedByUser User? @relation("RefundRequest_requestedByUser", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refund_requests_requested_by_user_id_fkey")
  approvedByUser User? @relation("RefundRequest_approvedByUser", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refund_requests_approved_by_user_id_fkey")
