# Local E2E storage only. Copy to backend/.env.test.
# npm run test:e2e restarts test containers and applies migrations to this DB.
# Never point these URLs at development or production storage.
# Dedicated auth/booking integration suites use their own URLs; see docs/PIPELINES.md.
NODE_ENV=test
POSTGRES_USER=pickleball
POSTGRES_PASSWORD=local_test_password
POSTGRES_DB=pickleball_test
TEST_POSTGRES_PORT=5435
DATABASE_URL=postgresql://pickleball:local_test_password@localhost:5435/pickleball_test?schema=public
REDIS_URL=redis://localhost:6381
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
