# Local backend only. Copy to backend/.env. See docs/OPERATIONS.md.
# Never copy backend secrets to frontend/.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:4001

# Match POSTGRES_* in infra/.env. PostgreSQL is published on port 5433.
DATABASE_URL=postgresql://pickleball:local_dev_password@localhost:5433/pickleball?schema=public

# RedisService uses REDIS_URL; BullMQ uses REDIS_HOST/PORT/PASSWORD.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=

# BullMQ booking expiry cadence/batch. Interval must be 5000-300000 ms;
# batch size must be 1-1000.
BOOKING_EXPIRY_INTERVAL_MS=15000
BOOKING_EXPIRY_BATCH_SIZE=100

# Required in every environment; generate separately with crypto.randomBytes(32).toString('hex').
JWT_SECRET=replace-with-your-own-random-64-hex-character-secret

# Leave empty for direct access. Otherwise use only your actual proxy IP/CIDR list.
TRUSTED_PROXY=

# Auth verification/recovery uses WEB_ORIGIN for browser links (tokens in URL fragments).
# Mailpit local only: npm run infra:up; view mail at http://127.0.0.1:8025.
# Production requires a real SMTP provider with TLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@smasharena.test
EMAIL_OTP_ENABLED=true
AUTH_MAIL_MAX_PER_HOUR=60
# Optional separate OTP HMAC secret; omit to use JWT_SECRET.
# AUTH_OTP_HMAC_SECRET=replace-with-a-separate-random-secret

# Optional PayOS: set all three with credentials for your environment.
# Empty values leave the provider unconfigured; do not use dummy non-empty keys.
# Verify-only needs PAYOS_CHECKSUM_KEY alone; money movement (gateway links,
# query, cancel, refund) needs all three. Demo/showcase deployments set ONLY
# a demo PAYOS_CHECKSUM_KEY (never real merchant keys) plus
# ENABLE_PAYMENT_SIMULATION=true — never enable simulation with real keys.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_CHANNEL_ID=PAYOS
# BE-PAY-DEMO — Showcase simulation. Mặc định TẮT. Chỉ bật ('true') trên
# deployment demo có DB/key tách khỏi dữ liệu thu tiền thật; deployment thu
# tiền thật không được bật. PAYOS_CHECKSUM_KEY của deployment demo phải là
# key demo (dùng để ký + xác minh webhook mô phỏng), không phải merchant key.
ENABLE_PAYMENT_SIMULATION=true
# Số tài khoản hiển thị trong payload demo (không nhận tiền thật).
PAYOS_DEMO_ACCOUNT_NUMBER=
GUEST_MANAGE_TOKEN_TTL_DAYS=30
# Optional AES-256-GCM key: separate random 64 hex characters.
# Omit to keep refund destinations in last4-only mode.
# REFUND_DESTINATION_KEY=replace-with-a-separate-random-64-hex-secret

# Task 5.1 — khóa mã hóa outbox thư phục hồi khách vãng lai (AES-256-GCM).
# Định dạng "v1:<hex64>,v2:<hex64>" để xoay khóa; bản đang dùng do ACTIVE_KEY_VERSION chọn.
# Không cấu hình thì đặt sân vẫn thành công, chỉ không gửi email phục hồi (Q3).
# GUEST_RECOVERY_OUTBOX_KEYS=v1:replace-with-your-own-64-hex-characters
# GUEST_RECOVERY_ACTIVE_KEY_VERSION=v1

AI_ASSISTANT_ENABLED=true

# Development/test seed only. Production is always denied.
# Seed never loads env automatically; explicitly load backend/.env with dotenv.
SEED_ENABLED=false
SEED_ALLOWED_HOST=localhost
SEED_ALLOWED_DATABASE=pickleball
# Required only for `npm run seed:admin` or `npm run seed:all`.
SEED_ADMIN_USERNAME=replace-admin-username
SEED_ADMIN_EMAIL=replace-admin@example.com
SEED_ADMIN_PHONE=0900000000
SEED_ADMIN_FULL_NAME=Replace Admin Name
SEED_ADMIN_PASSWORD=replace-with-a-strong-12-128-char-password
