{
  "name": "booking-project",
  "version": "0.0.1",
  "description": "QuanVu512's project",
  "author": "QuanVu512",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "npm run prisma:generate && cd backend && nest build",
    "build:web": "next build frontend",
    "deploy": "cd backend && nest deploy",
    "format": "prettier --write \"backend/src/**/*.{ts,tsx}\" \"backend/test/**/*.ts\" \"frontend/**/*.{ts,tsx,css}\"",
    "lint": "oxlint --type-aware backend/src/ backend/test/ frontend/",
    "start": "npm run prisma:generate && cd backend && nest start",
    "start:dev": "npm run prisma:generate && cd backend && nest start --watch",
    "start:debug": "npm run prisma:generate && cd backend && nest start --debug --watch",
    "start:prod": "node backend/dist/main.js",
    "web:dev": "next dev frontend --hostname 0.0.0.0 --port 4001",
    "web:start": "next start frontend --hostname 0.0.0.0 --port 4001",
    "test": "npm run test:backend && npm run test:frontend",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.unit.config.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.unit.config.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.config.js --runInBand",
    "pretest:e2e": "npm run db:test:restart",
    "test:e2e": "dotenv run --override -f backend/.env.test -- node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.config.js --runTestsByPath backend/test/app.e2e-spec.ts",
    "test:auth:contract": "npm run test:backend:contract && npm run test:frontend:contract",
    "test:auth:security": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.config.js --runInBand --runTestsByPath backend/src/modules/auth/auth-security.http.integration.spec.ts",
    "test:frontend:ui": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config frontend/jest.config.js --runInBand --testPathPatterns=rendering",
    "test:auth:ui": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config frontend/jest.config.js --runInBand --runTestsByPath frontend/__tests__/frontend-auth-rendering.spec.tsx",
    "test:auth:phones": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.config.js --runInBand --runTestsByPath backend/prisma/audit-auth-phones.spec.mjs backend/src/modules/auth/helpers/auth-normalization.spec.ts backend/test/phone-normalization-parity.spec.mjs backend/test/auth-phone-migration.spec.ts",
    "test:booking:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.config.js --runInBand --runTestsByPath backend/test/booking.integration.spec.ts",
    "test:booking:ui": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config frontend/jest.config.js --runInBand --runTestsByPath frontend/__tests__/frontend-booking-rendering.spec.tsx",
    "seed:courts": "prisma db seed --config backend/prisma.config.ts",
    "seed:admin": "node backend/prisma/seed.mjs --mode=admin",
    "seed:all": "node backend/prisma/seed.mjs --mode=all",
    "prisma:generate": "prisma generate --config backend/prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config backend/prisma.config.ts",
    "prisma:studio": "prisma studio --config backend/prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config backend/prisma.config.ts",
    "prisma:migrate:status": "prisma migrate status --config backend/prisma.config.ts",
    "auth:phones:audit": "node backend/prisma/audit-auth-phones.mjs",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d postgres redis",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "db:dev:remove": "docker compose --env-file .env -f infra/docker-compose.yml rm --stop --force postgres",
    "db:dev:create": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait postgres redis",
    "db:dev:restart": "npm run db:dev:remove && npm run db:dev:create && npm run prisma:migrate:dev",
    "db:test:remove": "docker compose --env-file backend/.env.test -f infra/docker-compose.yml rm --stop --force test-database test-redis",
    "db:test:create": "docker compose --env-file backend/.env.test -f infra/docker-compose.yml up -d --wait test-database test-redis",
    "db:test:restart": "npm run db:test:remove && npm run db:test:create && npm run prisma:test:deploy",
    "prisma:test:deploy": "dotenv run --override -f backend/.env.test -- prisma migrate deploy --config backend/prisma.config.ts",
    "prisma:test:studio": "dotenv run --override -f backend/.env.test -- prisma studio --config backend/prisma.config.ts",
    "prisma:dev:studio": "dotenv run --override -f backend/.env -- prisma studio --config backend/prisma.config.ts",
    "test:backend": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.unit.config.js --runInBand",
    "test:frontend": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config frontend/jest.config.js --runInBand",
    "test:backend:contract": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.config.js --runInBand --runTestsByPath backend/test/validation-response.e2e-spec.ts",
    "test:frontend:contract": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config frontend/jest.config.js --runInBand --runTestsByPath frontend/__tests__/frontend-auth-validation.spec.ts frontend/__tests__/frontend-network.spec.ts",
    "test:auth:storage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config backend/jest.config.js --runInBand --runTestsByPath backend/src/modules/auth/auth-storage.integration.spec.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "~12.0.0",
    "@nestjs/common": "~12.1.2",
    "@nestjs/config": "~12.0.1",
    "@nestjs/core": "~12.1.2",
    "@nestjs/jwt": "~12.0.2",
    "@nestjs/observe": "~0.3.6",
    "@nestjs/passport": "~12.0.0",
    "@nestjs/platform-express": "~12.1.2",
    "@nestjs/platform-socket.io": "~12.1.2",
    "@nestjs/swagger": "~12.0.2",
    "@nestjs/throttler": "~6.7.1",
    "@nestjs/websockets": "~12.0.4",
    "@payos/node": "~2.0.5",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "argon": "^2.0.21",
    "argon2": "^0.45.1",
    "bcrypt": "~6.0.0",
    "bullmq": "~6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "~18.0.6",
    "ioredis": "^6.0.0",
    "next": "~16.4.0",
    "nodemailer": "~10.1.1",
    "passport": "~0.7.0",
    "passport-jwt": "~4.0.1",
    "pg": "~8.23.1",
    "qrcode": "^1.5.4",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "redis": "~6.3.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2",
    "socket.io": "~4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "~12.0.8",
    "@nestjs/mau": "~0.2.8",
    "@nestjs/schematics": "~12.0.6",
    "@nestjs/testing": "~12.1.2",
    "@types/bcrypt": "~6.0.0",
    "@types/express": "~5.0.6",
    "@types/jest": "~30.0.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "~24.19.1",
    "@types/nodemailer": "~8.0.2",
    "@types/passport": "~1.0.17",
    "@types/passport-jwt": "~4.0.1",
    "@types/pg": "~8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "jest": "~30.5.2",
    "jsdom": "30.1.2",
    "oxlint": "~1.87.0",
    "oxlint-tsgolint": "~7.0.2003",
    "pactum": "^3.9.1",
    "prettier": "~3.9.9",
    "prisma": "~7.10.0",
    "source-map-support": "~0.5.21",
    "ts-jest": "~29.4.14",
    "typescript": "~6.0.3"
  },
  "generate": {
    "backend/prisma.config.ts": true
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.6"
    },
    "@nestjs/mau": {
      "undici": "^6.29.0",
      "tmp": "^0.2.7"
    }
  }
}
