# Copy to frontend/.env.local. Next.js loads env from frontend/.
# NEXT_PUBLIC_* values enter the browser bundle: never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:4001
NEXT_PUBLIC_COURT_DETAILS_ENABLED=true
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=true
# FE-PAY-DEMO — Hiển thị nút mô phỏng showcase. Mặc định false; server quyết định.
NEXT_PUBLIC_PAYMENT_SIMULATION_ENABLED=true
