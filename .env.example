# Local development only. Copy to .env and change placeholders for local use.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4000
# Booking MVP detail route is included; false hides catalog entry points.
NEXT_PUBLIC_COURT_DETAILS_ENABLED=true

POSTGRES_USER=pickleball
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=pickleball
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pickleball:local_dev_password@localhost:5433/pickleball?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=

# Required in every environment; generate separately with crypto.randomBytes(32).toString('hex').
JWT_SECRET=replace-with-your-own-random-64-hex-character-secret

# Leave empty for direct access. Otherwise use only your actual proxy IP/CIDR list.
TRUSTED_PROXY=

# Auth verification/recovery uses WEB_ORIGIN for browser links (tokens in URL fragments).
SMTP_HOST=replace-with-your-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace-with-your-smtp-user
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=replace-me@example.com

# Configure a provider only in a separate payment-integration task.
PAYMENT_PROVIDER=
PAYOS_CLIENT_ID=replace-me
PAYOS_API_KEY=replace-me
PAYOS_CHECKSUM_KEY=replace-me

# Development/test seed only. Production is always denied.
# Run with explicit DATABASE_URL exported (seed never loads a fallback .env).
SEED_ENABLED=false
SEED_ALLOWED_HOST=localhost
SEED_ALLOWED_DATABASE=pickleball
# Required only for `npm run seed:admin` or `npm run seed:all`.
SEED_ADMIN_USERNAME=replace-admin-username
SEED_ADMIN_EMAIL=replace-admin@example.com
SEED_ADMIN_PHONE=0900000000
SEED_ADMIN_FULL_NAME=Replace Admin Name
SEED_ADMIN_PASSWORD=replace-with-a-strong-12-128-char-password
