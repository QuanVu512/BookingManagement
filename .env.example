# Local development only. Copy to .env and change placeholders for local use.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4000
# Enable only when the court detail route is included in the release.
NEXT_PUBLIC_COURT_DETAILS_ENABLED=false

POSTGRES_USER=pickleball
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=pickleball
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pickleball:local_dev_password@localhost:5433/pickleball?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=

# Replace with a long random secret before using authentication outside local development.
JWT_SECRET=replace-this-local-placeholder-with-a-long-random-secret

# Configure a provider only in a separate payment-integration task.
PAYMENT_PROVIDER=
PAYOS_CLIENT_ID=replace-me
PAYOS_API_KEY=replace-me
PAYOS_CHECKSUM_KEY=replace-me
